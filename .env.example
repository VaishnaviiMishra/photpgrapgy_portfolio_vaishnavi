# ==============================================================================
# Portfolio Environment Variables Template
# Copy this file to .env or .env.local for local development.
# On Vercel / Netlify, add these under Settings -> Environment Variables.
# ==============================================================================

# 1. Cloudinary Configuration (For /addphoto direct upload)
VITE_CLOUDINARY_CLOUD_NAME="dcilsfof2"
VITE_CLOUDINARY_UPLOAD_PRESET="portfolio_uploads"

# 2. Email Configuration (Nodemailer with Gmail App Password)
EMAIL_USER="vaishnavisudha111@gmail.com"
EMAIL_PASS="your_16_char_google_app_password"
EMAIL_TO="vaishnavisudha111@gmail.com"

# 3. Persistent Database (For saving Cloudinary photos & Top Picks globally on Vercel)
# Option A: Upstash Redis (Recommended - Free on Vercel Storage or upstash.com)
UPSTASH_REDIS_REST_URL="https://your-upstash-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# Option B: GitHub Personal Access Token (Zero external DB signup - commits data to repo)
# GITHUB_TOKEN="ghp_your_personal_access_token"
# GITHUB_REPO="VaishnaviiMishra/photpgrapgy_portfolio_vaishnavi"
